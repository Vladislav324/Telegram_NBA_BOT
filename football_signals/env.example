# ────────────────────────────────────────────────
#  football_signals — переменные окружения
#  Скопируй в .env и заполни свои значения
#  НЕ коммить .env в Git!
# ────────────────────────────────────────────────

# API-Football (https://www.api-football.com)
API_FOOTBALL_KEY=your_key_here

# The Odds API (https://the-odds-api.com)
ODDS_API_KEY=your_key_here
ODDS_API_KEY_B=your_backup_key_here

# Telegram
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Google Sheets (путь к credentials.json)
GOOGLE_CREDENTIALS_PATH=credentials.json
SHEET_ID=your_sheet_id

# Betfair Exchange (опционально)
BETFAIR_USER=your_username
BETFAIR_PASS=your_password
BETFAIR_APPKEY=your_app_key

# Прокси (опционально)
PROXY_URL=http://127.0.0.1:12334
